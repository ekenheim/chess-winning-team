+/// Passed pawns and rook activity: the terms every review of our slipped
+/// wins asked for (pawns not pushed, rooks left on closed files).
+/// Bonus for a passed pawn by its relative rank (index 1 = 2nd rank).
+const PASSED_MG: [i32; 8] = [0, 5, 10, 15, 25, 40, 65, 0];
+const PASSED_EG: [i32; 8] = [0, 10, 20, 35, 60, 95, 140, 0];
+const ROOK_OPEN_FILE: (i32, i32) = (22, 10);
+const ROOK_HALF_OPEN_FILE: (i32, i32) = (10, 5);
+const ROOK_SEVENTH: (i32, i32) = (15, 25);
+
+/// Squares an enemy pawn would have to occupy to stop a pawn of `color` on
+/// `sq` from being passed: the three files ahead of it.
+fn passed_masks() -> &'static [[BitBoard; 64]; 2] {
+    static MASKS: OnceLock<[[BitBoard; 64]; 2]> = OnceLock::new();
+    MASKS.get_or_init(|| {
+        let mut out = [[BitBoard::EMPTY; 64]; 2];
+        for (ci, color) in [Color::White, Color::Black].into_iter().enumerate() {
+            for sq in Square::ALL {
+                let files = sq.file().bitboard() | sq.file().adjacent();
+                let mut ahead = BitBoard::EMPTY;
+                for rank in Rank::ALL {
+                    let is_ahead = match color {
+                        Color::White => rank > sq.rank(),
+                        Color::Black => rank < sq.rank(),
+                    };
+                    if is_ahead {
+                        ahead |= rank.bitboard();
+                    }
+                }
+                out[ci][sq as usize] = files & ahead;
+            }
+        }
+        out
+    })
+}
+
+/// (mg, eg) bonus for `color`'s passed pawns and rooks.
+fn pawn_rook_terms(board: &Board, color: Color) -> (i32, i32) {
+    let masks = &passed_masks()[color as usize];
+    let ours = board.colors(color);
+    let theirs = board.colors(!color);
+    let pawns = board.pieces(Piece::Pawn);
+    let our_pawns = pawns & ours;
+    let their_pawns = pawns & theirs;
+    let mut mg = 0;
+    let mut eg = 0;
+    for sq in our_pawns {
+        if (masks[sq as usize] & their_pawns).is_empty() {
+            let r = sq.rank().relative_to(color) as usize;
+            mg += PASSED_MG[r];
+            eg += PASSED_EG[r];
+        }
+    }
+    let seventh = Rank::Seventh.relative_to(color).bitboard();
+    for sq in board.pieces(Piece::Rook) & ours {
+        let file = sq.file().bitboard();
+        if (file & pawns).is_empty() {
+            mg += ROOK_OPEN_FILE.0;
+            eg += ROOK_OPEN_FILE.1;
+        } else if (file & our_pawns).is_empty() {
+            mg += ROOK_HALF_OPEN_FILE.0;
+            eg += ROOK_HALF_OPEN_FILE.1;
+        }
+        if seventh.has(sq) {
+            mg += ROOK_SEVENTH.0;
+            eg += ROOK_SEVENTH.1;
+        }
+    }
+    (mg, eg)
+}
